# CON-002 closure check (author: wi-producer-2026-11-25, who is not the fixer operator-mvasic). pre_fix_ref is the parent of 7c5d92a, the commit that moved the constitution gitlink to f92868dd (git log -1 7c5d92a).
# Codeberg and m3w URLs carry the git@ user exactly as upstreams/codeberg.sh declares it (without it ssh uses the local user and is refused).
# Exit 0 only if the gitlink equals refs/heads/main on ALL eight upstreams; 1 if any differs; 2 if any ls-remote returns nothing or fails.
check_id=chk-con-gitlink-current-all-remotes
pre_fix_ref=7c5d92a^
cmd=export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes'; g=$(git ls-files -s submodules/constitution | awk '{print $2}'); [ -n "$g" ] || exit 2; d=0; for u in git@github.com:HelixDevelopment/HelixConstitution.git ssh://git@codeberg.org/HelixDevelopment/constitution.git git@gitflic.ru:helixdevelopment/helixconstitution.git git@gitlab.com:helixdevelopment1/helixconstitution.git git@gitverse.ru:helixdevelopment/HelixConstitution.git ssh://git@git.m3w.org:2222/Helix/constitution.git git@github.com:vasic-digital/HelixConstitution.git git@gitlab.com:vasic-digital/HelixConstitution.git; do r=$(timeout 60 git ls-remote "$u" refs/heads/main 2>/dev/null | awk '{print $1}' | head -1); [ -n "$r" ] || { echo "UNDETERMINED $u"; exit 2; }; if [ "$r" = "$g" ]; then echo "CURRENT $u $r"; else echo "DIFFERS $u gitlink=$g remote=$r"; d=1; fi; done; exit $d
