    {
      "type": "section",
      "id": "about",
      "eyebrow": {
        "i18n": "about.eyebrow",
        "text": "// hakkında"
      },
      "title": {
        "i18n": "about.title",
        "text": "Bir filo, monolit değil."
      },
      "groups": [
        {
          "kind": "prose",
          "paras": [
            {
              "class": "vd-lede",
              "i18n": "about.body1",
              "text": "Vasic Digital, AI‑geliştirme ürünleri ve yeniden kullanılabilir modüllerden oluşan birbirine bağlı bir aileyi inşa eden odaklı bir mühendislik pratiğidir. Tek bir monolit yerine, çalışma bir filo olarak düzenlenir: onlarca küçük, bağımsız‑test edilmiş, ayrık modülün üzerine büyük ürün uygulamaları — böylece kanıtlanmış parçalar her ürün içinde yeniden kullanılır, yeniden inşa edilmez."
            },
            {
              "class": "vd-lede vd-muted",
              "i18n": "about.body2",
              "text": "Omurgadaki dil Go'dur, Kotlin & Kotlin Multiplatform, TypeScript/React, Python, Swift ve Shell ile tamamlanır — iş gereksinimine göre seçilir. Filoyu bir arada tutan şey, mekanik hâle getirilen disiplin: her proje, bir Git alt modülü olarak paylaşılan bir mühendislik Anayasasını devralır ve bir ürünün reklam ettiği her yetenek, otomatik, kanıt üreten bir test tarafından desteklenmelidir. Bir özellik, testler geçtiğinde \"tamam\" değildir; gerçek bir kullanıcı gerçekten kullanabildiğinde ve bunu kanıtlayan kanıt yakalandığında tamamdır."
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "id": "work",
      "eyebrow": {
        "i18n": "work.eyebrow",
        "text": "// ne yapıyoruz"
      },
      "title": {
        "i18n": "work.title",
        "text": "AI‑tabanlı geliştirme, uçtan uca."
      },
      "lede": {
        "i18n": "work.lede",
        "text": "AI sistemleri için altyapıyı inşa ediyoruz — uygulamanın altındaki zor kısım."
      },
      "groups": [
        {
          "kind": "cards",
          "grid": "vd-grid vd-grid--two",
          "cards": [
            {
              "nameI18n": "wd.llm.title",
              "name": "Çoklu sağlayıcı LLM erişimi",
              "blurb": {
                "i18n": "wd.llm.body",
                "text": "40+ sağlayıcı üzerinde birinci‑taraf soyutlama — Anthropic/Claude, OpenAI, DeepSeek, Gemini, Mistral, Groq, xAI/Grok ve yedek olarak yerel Ollama — tek bir arayüzde, yeniden denemeler, devre kesiciler ve sağlık kontrolleri ile."
              }
            },
            {
              "nameI18n": "wd.agents.title",
              "name": "Ajan orkestrasyonu",
              "blurb": {
                "i18n": "wd.agents.body",
                "text": "Kafasız CLI kod‑ajanı kontrol düzlemleri, grafik‑tabanlı ajan‑odaklı iş akışları, çok‑turlu \"AI tartışması\" mutabakatı ve DAG/boru hattı çalışma zamanları."
              }
            },
            {
              "nameI18n": "wd.verify.title",
              "name": "LLM doğrulaması",
              "blurb": {
                "i18n": "wd.verify.body",
                "text": "Modelleri zorunlu bir kavrama kapısı (\"Kodumu görüyor musun?\") ve gecikme, akış, fonksiyon‑çağrısı, görsel ve gömme testleri ile puanlayan bir güven katmanı — yalnızca doğrulanmış yapılandırma dışa aktarır."
              }
            },
            {
              "nameI18n": "wd.memory.title",
              "name": "Getirme & bellek",
              "blurb": {
                "i18n": "wd.memory.body",
                "text": "RAG, vektör veritabanları, gömmeler ve birleşik ajan‑bellek motorları (Mem0 + Cognee + Letta) sınırsız‑bağlam sıkıştırması ile."
              }
            },
            {
              "nameI18n": "wd.defensive.title",
              "name": "Savunmalı LLM",
              "blurb": {
                "i18n": "wd.defensive.body",
                "text": "Koruma hatları, KVK tespiti, adversarial kırmızı‑takım senaryoları ve girdi standartlaştırması — güvenlik altyapıya yerleşiktir, sonradan eklenmez."
              }
            }
          ]
        }
      ]
