# Template for ~/.config/vasic/storage.env (machine-local; sourced from ~/.bashrc and ~/.profile).
# Copy to ~/.config/vasic/storage.env and replace each placeholder with the host's own mount point.
# No secrets. See docs/storage-policy.md section 3 for the variables derived from these two.
VASIC_FAST_STORE=<fast-drive-mount>/claude-work
VASIC_BULK_STORE=<bulk-drive-mount>/claude-work
