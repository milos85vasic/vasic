    {
      "type": "section",
      "id": "about",
      "eyebrow": {
        "i18n": "about.eyebrow",
        "text": "// 关于"
      },
      "title": {
        "i18n": "about.title",
        "text": "一支舰队，而非单体。"
      },
      "groups": [
        {
          "kind": "prose",
          "paras": [
            {
              "class": "vd-lede",
              "i18n": "about.body1",
              "text": "Vasic Digital 是一家专注的工程实践，构建互联的 AI 开发产品族和可复用模块。工作不是单体，而是舰队：在数十个小型、独立测试、解耦的模块之上构建大型产品应用——因此经验证的部件在每个产品中复用，而不是重新构建。"
            },
            {
              "class": "vd-lede vd-muted",
              "i18n": "about.body2",
              "text": "核心语言是 Go，辅以 Kotlin 与 Kotlin Multiplatform、TypeScript/React、Python、Swift 和 Shell——根据任务选择。将舰队连结在一起的是机械化的纪律：每个项目继承作为 Git 子模块的共享工程宪法，每项产品宣传的能力必须由自动化、产出证据的测试支撑。特性不是在测试通过时“完成”，而是在真实用户能够实际使用并捕获证据证明时才算完成。"
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "id": "work",
      "eyebrow": {
        "i18n": "work.eyebrow",
        "text": "// 我们的业务"
      },
      "title": {
        "i18n": "work.title",
        "text": "基于 AI 的端到端开发。"
      },
      "lede": {
        "i18n": "work.lede",
        "text": "我们构建 AI 系统的基底——应用之下的硬核部分。"
      },
      "groups": [
        {
          "kind": "cards",
          "grid": "vd-grid vd-grid--two",
          "cards": [
            {
              "nameI18n": "wd.llm.title",
              "name": "多供应商 LLM 接入",
              "blurb": {
                "i18n": "wd.llm.body",
                "text": "首方抽象层，覆盖 40+ 供应商——Anthropic/Claude、OpenAI、DeepSeek、Gemini、Mistral、Groq、xAI/Grok，以及本地 Ollama 作为后备——统一接口，具备重试、断路器和健康检查。"
              }
            },
            {
              "nameI18n": "wd.agents.title",
              "name": "代理编排",
              "blurb": {
                "i18n": "wd.agents.body",
                "text": "无头 CLI 编码代理控制平面、基于图的代理工作流、多轮“AI 辩论”共识以及 DAG/流水线运行时。"
              }
            },
            {
              "nameI18n": "wd.verify.title",
              "name": "LLM 验证",
              "blurb": {
                "i18n": "wd.verify.body",
                "text": "信任层，通过强制理解门（“你看到我的代码了吗？”）以及延迟、流式、函数调用、视觉和嵌入测试为模型打分——导出仅已验证的配置。"
              }
            },
            {
              "nameI18n": "wd.memory.title",
              "name": "检索与记忆",
              "blurb": {
                "i18n": "wd.memory.body",
                "text": "RAG、向量数据库、嵌入以及融合的代理记忆引擎（Mem0 + Cognee + Letta），具备无限上下文压缩。"
              }
            },
            {
              "nameI18n": "wd.defensive.title",
              "name": "防御性 LLM",
              "blurb": {
                "i18n": "wd.defensive.body",
                "text": "护栏、PII 检测、对抗性红队夹具和输入规范化——安全内置于基底，而非后加。"
              }
            }
          ]
        }
      ]
    },
