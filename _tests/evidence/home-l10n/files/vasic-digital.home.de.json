      "eyebrow": {
        "i18n": "work.eyebrow",
        "text": "// was wir tun"
      },
      "title": {
        "i18n": "work.title",
        "text": "KI‑basierte Entwicklung, von Anfang bis Ende."
      },
      "lede": {
        "i18n": "work.lede",
        "text": "Wir bauen das Substrat für KI‑Systeme — den harten Teil unter der Anwendung."
      },
      "groups": [
        {
          "kind": "cards",
          "grid": "vd-grid vd-grid--two",
          "cards": [
            {
              "nameI18n": "wd.llm.title",
              "name": "Multi‑Provider‑LLM‑Zugriff",
              "blurb": {
                "i18n": "wd.llm.body",
                "text": "Eine First‑Party‑Abstraktion über 40+ Anbieter — Anthropic/Claude, OpenAI, DeepSeek, Gemini, Mistral, Groq, xAI/Grok und lokales Ollama als Fallback — hinter einer Schnittstelle mit Wiederholungen, Circuit‑Breakern und Gesundheits‑Checks."
              }
            },
            {
              "nameI18n": "wd.agents.title",
              "name": "Agenten‑Orchestrierung",
              "blurb": {
                "i18n": "wd.agents.body",
                "text": "Headless‑CLI‑Coding‑Agent‑Steuerungsebenen, graphbasierte agentische Workflows, mehrstufige „KI‑Debatte“-Konsens und DAG/Pipeline‑Laufzeiten."
              }
            },
            {
              "nameI18n": "wd.verify.title",
              "name": "LLM‑Verifizierung",
              "blurb": {
                "i18n": "wd.verify.body",
                "text": "Eine Vertrauensschicht, die Modelle mit einem obligatorischen Verständnis‑Gate („Siehst du meinen Code?“) plus Latenz‑, Streaming‑, Funktions‑Aufruf‑, Vision‑ und Embedding‑Tests bewertet — exportiert eine nur‑verifizierte Konfiguration."
              }
            },
            {
              "nameI18n": "wd.memory.title",
              "name": "Abruf‑ & Speicher",
              "blurb": {
                "i18n": "wd.memory.body",
                "text": "RAG, Vektor‑Datenbanken, Embeddings und fusionierte Agent‑Speicher‑Engines (Mem0 + Cognee + Letta) mit unendlicher Kontext‑Kompression."
              }
            },
            {
              "nameI18n": "wd.defensive.title",
              "name": "Defensiver LLM",
              "blurb": {
                "i18n": "wd.defensive.body",
                "text": "Schutzschienen, PII‑Erkennung, adversariale Red‑Team‑Fixtures und Eingabe‑Kanonisierung — Sicherheit im Substrat, nicht nachträglich angebracht."
              }
            }
          ]
        }
      ]
